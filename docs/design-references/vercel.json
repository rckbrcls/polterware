{
  "source": "vercel.com dashboard (logged-in team overview, dark theme), Geist design system",
  "measured": "2026-10-29",
  "viewport": "1440x900",
  "priority": "lowest of the four references; kept for the gray scale and the shadow ladder",
  "typography": {
    "family": "Geist Sans",
    "mono": "Geist Mono",
    "uses": {
      "body_and_controls": "14px / 20px / 400-500, letter-spacing -0.28px on emphasis",
      "meta": "12px / 16px / 500",
      "label": "11px / 20px / 500, letter-spacing 0.2px"
    }
  },
  "color": {
    "background": { "100": "#0a0a0a", "200": "#000000" },
    "gray": {
      "100": "#1a1a1a",
      "200": "#1f1f1f",
      "300": "#292929",
      "400": "#2e2e2e",
      "500": "#454545",
      "600": "#878787",
      "700": "#8f8f8f",
      "800": "#7d7d7d",
      "900": "#a1a1a1",
      "1000": "#ededed"
    },
    "gray_alpha": { "100": "#ffffff @ 6%", "200": "#ffffff @ 9%", "400": "#ffffff @ 14%" },
    "text": { "primary": "#ededed", "secondary": "#a1a1a1" },
    "accent": { "blue_700": "#006efe", "blue_900": "#47a8ff", "green_700": "#00ac3a", "red_700": "#f13342", "amber_700": "#ffae00" }
  },
  "elevation": {
    "border_as_shadow": "0 0 0 1px #ffffff @ 14.5% (borders are ring shadows, not CSS borders)",
    "small": "0 1px 2px #000 @ 16%",
    "medium": "0 2px 2px #000 @ 32%, 0 8px 8px -8px #000 @ 16%",
    "large": "0 2px 2px #000 @ 4%, 0 8px 16px -4px #000 @ 4%",
    "card": "ring 1px #fff@14.5% + 0 1px 2px #000@16% + outer 1px black ring"
  },
  "radius": { "sm": "4px", "md": "6px (buttons, cards)", "lg": "8px", "xl": "12px", "pill": "full (avatars, status)" },
  "spacing": "4px base: 8, 12, 16, 24, 32, 40, 64, 96, 128 (geist-space)",
  "layout": {
    "header": "56px with 1px #1f1f1f bottom border",
    "sidebar": "256px, items 36px tall, padding 0 10px, radius 6px, 14px/500",
    "content_rows": "project cards 128px, list rows 32-36px"
  },
  "components": {
    "button": "32px (page) / 36px (primary), padding 0 12px, radius 6px, 14px/500",
    "icon_button": "32px, radius full",
    "input": "36px, padding 0 12px, 14px"
  },
  "motion": {
    "default": "150ms cubic-bezier(0.4, 0, 0.2, 1)",
    "enter": "200ms cubic-bezier(0, 0, 0.2, 1)",
    "slow": "300ms cubic-bezier(0.4, 0, 0.2, 1)"
  }
}
