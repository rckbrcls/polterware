{
  "name": "@polterware/workspace",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:polterware": "turbo run dev --filter=@polterware/polterware-desktop",
    "dev:notes": "turbo run dev --filter=@polterware/notes-desktop",
    "dev:vitals": "turbo run dev --filter=@polterware/vitals-desktop",
    "dev:web": "turbo run dev --filter=@polterware/web",
    "dev:gallery": "turbo run dev --filter=@polterware/gallery",
    "dev:core": "bash scripts/dev.sh --core-only",
    "build": "turbo run build",
    "build:polterware": "turbo run build --filter=@polterware/polterware-desktop",
    "build:notes": "turbo run build --filter=@polterware/notes-desktop",
    "build:vitals": "turbo run build --filter=@polterware/vitals-desktop",
    "build:web": "turbo run build --filter=@polterware/web",
    "build:gallery": "turbo run build --filter=@polterware/gallery",
    "build:cli": "mkdir -p dist && cd backend && go build -o ../dist/polterware ./runtimes/cli",
    "build:notes-core": "mkdir -p dist && cd notes/backend && go build -o ../../dist/pwnotes ./runtimes/cli",
    "preview": "turbo run preview",
    "preview:polterware": "turbo run preview --filter=@polterware/polterware-desktop",
    "preview:notes": "turbo run preview --filter=@polterware/notes-desktop",
    "preview:vitals": "turbo run preview --filter=@polterware/vitals-desktop",
    "preview:web": "turbo run preview --filter=@polterware/web",
    "typecheck": "turbo run typecheck",
    "typecheck:polterware": "turbo run typecheck --filter=@polterware/polterware-desktop...",
    "typecheck:notes": "pnpm --filter \"@polterware/*notes*\" typecheck",
    "typecheck:vitals": "turbo run typecheck --filter=@polterware/vitals-desktop...",
    "typecheck:web": "turbo run typecheck --filter=@polterware/web...",
    "test": "turbo run test",
    "test:polterware": "turbo run test --filter=@polterware/polterware-desktop...",
    "test:notes": "pnpm --filter \"@polterware/*notes*\" test",
    "test:vitals": "turbo run test --filter=@polterware/vitals-desktop...",
    "test:e2e:notes": "pnpm --filter @polterware/notes-desktop test:e2e",
    "test:integration": "bash tooling/test-integration.sh",
    "test:security": "bash tooling/test-security.sh",
    "test:ui-opacity": "node --test tooling/check-ui-opacity.test.mjs",
    "dist:polterware:mac": "bash tooling/release/dist-mac.sh polterware",
    "dist:notes:mac": "bash tooling/release/dist-mac.sh notes",
    "dist:vitals:mac": "bash tooling/release/dist-mac.sh vitals",
    "deps:electron": "turbo run deps:electron --filter=@polterware/polterware-desktop",
    "lint": "oxlint . && (turbo run lint --continue || true)",
    "format:check": "echo 'format:check ok (prettier optional until packages wired)'",
    "design:lint": "node tooling/check-ui-opacity.mjs",
    "generate": "bash tooling/generate.sh",
    "verify": "bash tooling/verify.sh",
    "verify:notes": "bash tooling/verify-notes.sh"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.85.0",
    "oxlint": "1.85.0",
    "turbo": "^2.11.3",
    "typescript": "7.0.2"
  }
}
