{
  "name": "@polterware/vitals-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Electron desktop shell for Polterware Vitals SSH metrics.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist:mac": "bash ../../tooling/release/dist-mac.sh vitals",
    "deps:electron": "node -e \"const pkg = require('./package.json'); console.log(pkg.devDependencies.electron);\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run src/main src/preload src/shared"
  },
  "dependencies": {
    "@polterware/frontend-design-system": "workspace:*",
    "@polterware/frontend-shell": "workspace:*",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "solid-js": "^1.9.15",
    "ssh2": "^1.16.0",
    "uplot": "^1.6.31"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.6",
    "@types/ssh2": "^1.15.6",
    "electron": "44.4.5",
    "electron-builder": "^26.15.3",
    "electron-log": "^5.4.4",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.1"
  }
