{
  "name": "@polterware/notes-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Electron desktop shell for Polterware Notes.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "core:build": "pnpm --dir ../.. build:notes-core",
    "native:build": "bash native/scripts/build.sh",
    "dev": "pnpm native:build && pnpm core:build && electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "pnpm native:build && electron-vite build",
    "preview": "electron-vite preview",
    "dist:mac": "bash ../../tooling/release/dist-mac.sh notes",
    "deps:electron": "node -e \"const pkg = require('./package.json'); console.log(pkg.devDependencies.electron);\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run src/main src/preload src/renderer",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.15.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-node": "^2.2.0",
    "@polterware/feature-notes-attachments": "workspace:*",
    "@polterware/feature-notes-calendar": "workspace:*",
    "@polterware/feature-notes-focus": "workspace:*",
    "@polterware/feature-notes-map": "workspace:*",
    "@polterware/feature-notes-library": "workspace:*",
    "@polterware/feature-notes-spaces": "workspace:*",
    "@polterware/feature-notes-schedule": "workspace:*",
    "@polterware/feature-notes-search": "workspace:*",
    "@polterware/feature-notes-settings": "workspace:*",
    "@polterware/feature-notes-shell": "workspace:*",
    "@polterware/frontend-design-system": "workspace:*",
    "@polterware/notes-contracts": "workspace:*",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.6",
    "electron": "44.4.5",
    "electron-builder": "^26.15.3",
    "electron-log": "^5.4.4",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.1.1",
    "solid-js": "^1.9.15",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.1"
  }
}
