{
  "compilerOptions": {
    "target": "ESNext",
    "ignoreDeprecations": "6.0",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "solid-js",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "@polterware/feature-canvas": ["../../packages/features/canvas/src/index.tsx"],
      "@/*": [
        "./src/renderer/*"
      ]
    },
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "src/**/*",
    "electron.vite.config.ts"
  ]
}
