{
  "name": "@polterware/polterware-desktop",
  "private": true,
  "version": "0.1.1",
  "description": "Electron desktop shell for Polterware.",
  "productName": "Polterware",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "core:build": "pnpm --dir ../.. build:cli",
    "dev": "pnpm core:build && electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist:mac": "bash ../../tooling/release/dist-mac.sh polterware",
    "deps:electron": "node -e \"const pkg = require('./package.json'); console.log(pkg.devDependencies.electron);\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "echo e2e via go integration gate"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.15.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-node": "^2.2.0",
    "@polterware/contracts": "workspace:*",
    "@polterware/feature-architecture": "workspace:*",
    "@polterware/feature-commander": "workspace:*",
    "@polterware/feature-dispatch": "workspace:*",
    "@polterware/feature-integrations": "workspace:*",
    "@polterware/feature-knowledge": "workspace:*",
    "@polterware/feature-settings": "workspace:*",
    "@polterware/feature-shell": "workspace:*",
    "@polterware/frontend-design-system": "workspace:*",
    "@polterware/frontend-platform": "workspace:*",
    "@polterware/frontend-state": "workspace:*",
    "@tanstack/solid-virtual": "3.13.40",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.6",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-log": "^5.4.4",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.1.1",
    "solid-js": "^1.9.15",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.1"
  }
}
