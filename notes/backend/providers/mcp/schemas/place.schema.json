{
  "$id": "pwnotes://schemas/place",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lat",
    "lng"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "lat": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "lng": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "radiusM": {
      "type": "number",
      "minimum": 25,
      "maximum": 5000
    },
    "event": {
      "type": "string",
      "enum": [
        "enter",
        "exit"
      ]
    }
  }
}
