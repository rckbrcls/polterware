{
  "$id": "pwnotes://schemas/schedule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "at"
  ],
  "properties": {
    "at": {
      "type": "string",
      "description": "ISO instant, or YYYY-MM-DD for all-day."
    },
    "tz": {
      "type": "string",
      "description": "IANA zone."
    },
    "repeat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "freq"
      ],
      "properties": {
        "freq": {
          "type": "string",
          "enum": [
            "minutely",
            "hourly",
            "daily",
            "weekly",
            "monthly",
            "yearly"
          ]
        },
        "every": {
          "type": "integer",
          "minimum": 1
        },
        "weekdays": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "sun",
              "mon",
              "tue",
              "wed",
              "thu",
              "fri",
              "sat"
            ]
          }
        },
        "until": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "focus": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workMin": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "shortBreakMin": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "longBreakMin": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "cycles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "autoContinue": {
          "type": "boolean"
        }
      }
    }
  }
}
